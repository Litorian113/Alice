# Copy to .env and add your key locally. Never add the key to this template.
# Reserved for the backend token service; the iOS app does not load this file.
ASSEMBLYAI_API_KEY=

# Bob Shell API key (inference type). Export it as BOB_API_KEY when running `bob run` for the demo.
BOB_KEY=
# Optional: general-type Bob key (needs `bob run --team-id <id>`).
BOB_GENERAL_KEY=
