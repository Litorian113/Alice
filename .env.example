# Copy to .env and add your key locally. Never add the key to this template.
# Loaded by the local relay and dev runner; never bundled in the iOS app.
ASSEMBLYAI_API_KEY=
ASSEMBLYAI_REGION=eu
ASSEMBLYAI_SPEECH_MODEL=universal-3-6-pro

# Bob Shell API key (inference type). Export it as BOB_API_KEY when running `bob run` for the demo.
BOB_KEY=
# Optional for the ACP desktop chat (otherwise use its IBM sign-in button).
BOB_API_KEY=
# Optional: general-type Bob key (needs `bob run --team-id <id>`).
BOB_GENERAL_KEY=
